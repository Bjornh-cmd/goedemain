SESSION_SECRET=vervang-dit-met-een-lange-willekeurige-string
PORT=3000
# Bind-adres (Coolify/Docker: 0.0.0.0)
HOST=0.0.0.0

# Welke bezoeker admin-rechten heeft (standaard: bjorn)
ADMIN_VISITOR_ID=bjorn

# false op http://localhost — true alleen achter HTTPS
# Op Coolify met HTTPS-domein: laat leeg (auto via proxy) of zet true
COOKIE_SECURE=false

# Optioneel: trust proxy (Coolify zet dit automatisch via COOLIFY_* vars)
# TRUST_PROXY=1

# Lokale database = data/config.json
# Beheer via Admin-knop na inloggen als bjorn

# Optioneel: Vercel API — projecten automatisch als knoppen importeren
# Token: https://vercel.com/account/tokens
# VERCEL_TOKEN=vcp_xxxxxxxx
# VERCEL_TEAM_ID=team_xxxxxxxx   # alleen nodig bij team-account
